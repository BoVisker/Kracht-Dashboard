# Copy to .env.local for local dev (gitignored). In CI/production these
# come from GitHub repo Variables (Settings > Secrets and variables >
# Actions > Variables tab) -- see .github/workflows/deploy.yml.
#
# Both of these are PUBLIC by design: the Supabase anon key is meant to
# ship in a browser bundle, and every table it can touch is locked down
# by Row Level Security (see supabase/migrations/0001_init.sql). Do NOT
# put the Supabase service_role key or any provider API key/secret here
# -- those belong in Supabase project secrets (`supabase secrets set`),
# consumed only by Edge Functions, never by the frontend. Details in
# ARCHITECTURE.md.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
